+constexpr std::size_t MAX_PENDING_LIDAR_SCANS = 1;
+std::uint64_t dropped_lidar_scans = 0;
+
+void clear_lidar_buffers_locked()
+{
+    lidar_buffer.clear();
+    time_buffer.clear();
+    lidar_pushed = false;
+}
+
+void trim_lidar_buffer_locked()
+{
+    if (lidar_buffer.size() != time_buffer.size() ||
+        (lidar_pushed && lidar_buffer.empty()))
+    {
+        clear_lidar_buffers_locked();
+        return;
+    }
+
+    // sync_packages() may already hold the front scan while waiting for IMU.
+    // Preserve that scan and keep only the newest not-yet-processed scan.
+    const std::size_t protected_scans = lidar_pushed ? 1U : 0U;
+    while (lidar_buffer.size() > protected_scans + MAX_PENDING_LIDAR_SCANS)
+    {
+        lidar_buffer.erase(lidar_buffer.begin() + protected_scans);
+        time_buffer.erase(time_buffer.begin() + protected_scans);
+        ++dropped_lidar_scans;
+    }
+}
+
