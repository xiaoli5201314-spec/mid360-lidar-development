<?xml version="1.0"?>
<!--
  R680 visual-only model for RViz.

  Frame convention:
    base_link is the rear-axle midpoint at ground level.
    +X points to the front of the vehicle, +Y to the vehicle's left,
    and +Z upward.

  Confirmed navigation envelope: x=-0.15..+0.67 m, y=-0.38..+0.38 m.
  This is intentionally a simple visual model; it is not a collision model
  and does not replace the Nav2 footprint parameters.
-->
<robot name="r680_vehicle">
  <material name="body_blue">
    <color rgba="0.08 0.25 0.55 1.0"/>
  </material>
  <material name="body_light">
    <color rgba="0.30 0.48 0.72 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.035 0.035 0.04 1.0"/>
  </material>
  <material name="rim_gray">
    <color rgba="0.52 0.56 0.60 1.0"/>
  </material>
  <material name="radar_cyan">
    <color rgba="0.05 0.76 0.82 1.0"/>
  </material>
  <material name="front_red">
    <color rgba="0.88 0.08 0.05 1.0"/>
  </material>

  <link name="base_link">
    <visual name="main_chassis">
      <origin xyz="0.26 0.0 0.27" rpy="0 0 0"/>
      <geometry>
        <!-- Measured chassis width, excluding the wheels: about 0.40 m. -->
        <box size="0.82 0.40 0.20"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="upper_deck">
      <origin xyz="0.22 0.0 0.405" rpy="0 0 0"/>
      <geometry>
        <box size="0.58 0.36 0.07"/>
      </geometry>
      <material name="body_light"/>
    </visual>
    <visual name="front_marker">
      <origin xyz="0.635 0.0 0.36" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.18 0.08"/>
      </geometry>
      <material name="front_red"/>
    </visual>
  </link>

  <!-- MID-360S center: 0.60 m in front of the rear axle and 0.40 m above ground. -->
  <link name="mid360s_link">
    <visual name="mid360s_body">
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.095" length="0.13"/>
      </geometry>
      <material name="radar_cyan"/>
    </visual>
    <visual name="mid360s_dome">
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.075"/>
      </geometry>
      <material name="radar_cyan"/>
    </visual>
  </link>
  <joint name="mid360s_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid360s_link"/>
    <origin xyz="0.60 0.0 0.40" rpy="0 0 0"/>
  </joint>

  <!-- Wheel centers are at the measured 0.76 m overall width envelope. -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.14" length="0.12"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="rear_left_rim">
      <origin xyz="0 -0.062 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.065" length="0.012"/></geometry>
      <material name="rim_gray"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0.0 0.32 0.14" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.14" length="0.12"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="rear_right_rim">
      <origin xyz="0 0.062 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.065" length="0.012"/></geometry>
      <material name="rim_gray"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0.0 -0.32 0.14" rpy="0 0 0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.14" length="0.12"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="front_left_rim">
      <origin xyz="0 -0.062 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.065" length="0.012"/></geometry>
      <material name="rim_gray"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.53 0.32 0.14" rpy="0 0 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.14" length="0.12"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="front_right_rim">
      <origin xyz="0 0.062 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.065" length="0.012"/></geometry>
      <material name="rim_gray"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.53 -0.32 0.14" rpy="0 0 0"/>
  </joint>
</robot>
